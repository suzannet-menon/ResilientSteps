# ============================================================
# ResilientSteps Backend - Environment Variables
# ============================================================
# Copy this file to .env and replace all placeholder values
# with your actual credentials:
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT verification (find this in Supabase dashboard → Settings → API)
# For symmetric HS256 validation (used by local Supabase emulation):
SUPABASE_JWT_SECRET=your-jwt-secret-here

# For asymmetric ES256 JWKS validation (JSON string of public keys, used in production/cloud):
# SUPABASE_JWKS='{"keys": [{"x": "...", "y": "...", "alg": "ES256", "crv": "P-256", "ext": true, "kid": "...", "kty": "EC", "key_ops": ["verify"]}]}'

# Database (Supabase direct connection string)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Shade sidecar (R-074/GEE Phase 1; OPTIONAL)
# Local Postgres (docker compose service `shade-db`, port 5433) holding
# satellite-derived shade keyed by (road_segment_id, dataset_version). The
# main DATABASE_URL is never written to by the GEE batch. Leave unset to run
# with OSM-canopy shade only - all routes degrade safely.
SHADE_DB_URL=postgresql+asyncpg://shade:shade_local@localhost:5433/shade_db

# Routing engine (Valhalla via Docker)
VALHALLA_BASE_URL=http://localhost:8002

# Geocoding
PHOTON_BASE_URL=https://photon.komoot.io

# Map tiles (get a free key at https://www.maptiler.com)
MAPTILER_API_KEY=your-maptiler-api-key-here

# Admin moderation (choose a long random string, e.g. via: python -c "import secrets; print(secrets.token_urlsafe(36))")
ADMIN_API_KEY=your-admin-api-key-here

# Rate limiting behind a proxy (optional, default 0)
# Number of proxies you control in front of the API. Set it when clients reach
# the app through a remote proxy (load balancer, separate nginx container) so
# the limiter keys on the X-Forwarded-For client address instead of the proxy's
# address, which would otherwise put every user in one bucket.
# Leave at 0 for direct connections; local tunnels (ngrok, cloudflared) and a
# proxy on the same host are detected automatically.
TRUSTED_PROXY_DEPTH=0

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here

# Nugen Intelligence (WP14 report classification; backend-only, never mobile)
# Key: platform.nugen.in -> dashboard -> API keys
# Model: EXACT Hugging Face id from GET {NUGEN_BASE_URL}/models/base - pick a
# model with BOTH inference_ready=true and alignment_ready=true (real-time
# chat-completions rejects inference_ready=false ids). First verified pick:
# meta-llama/Llama-3.2-3B-Instruct (Qwen2.5-7B is alignment-only, not
# inference_ready - set aside until Nugen's server loads it for real-time).
# Classification stays OFF until BOTH vars are set; everything degrades to
# confidence 0.5 without them (offline-safe by design).
NUGEN_API_KEY=your-api-key
NUGEN_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Optional override (default https://api.nugen.in/api/v3/inference)
# NUGEN_BASE_URL=https://api.nugen.in/api/v3/inference
